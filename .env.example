# Copy this file to `.env` and fill in real values. Never commit `.env`.

APP_ENV=development
LOG_LEVEL=INFO

# Model provider
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5
AGENT_MAX_ITERATIONS=25
AGENT_MAX_OUTPUT_TOKENS=8192

# GitHub credentials
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_BOT_USERNAME=your-bot-account
GITHUB_BOT_EMAIL=bot@example.com
GITHUB_API_BASE_URL=https://api.github.com

# Sandbox backend: docker or local
SANDBOX_BACKEND=docker
SANDBOX_DOCKER_IMAGE=python:3.11-slim
SANDBOX_WORKSPACE_ROOT=/tmp/ghbot-workspaces
SANDBOX_COMMAND_TIMEOUT_SECONDS=120
SANDBOX_MAX_FILE_BYTES=2000000
# Keep failed workspaces for inspection.
SANDBOX_KEEP_WORKSPACE_ON_FAILURE=true
